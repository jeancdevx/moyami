    "astro": "7.4.0",
    "leaflet": "1.9.4",
    "maplibre-gl": "6.14.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/compiler-rs": "0.5.2",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.x"
  },
  "packageManager": "pnpm@10.33.2"
