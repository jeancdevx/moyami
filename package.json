  "type": "module",
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "dev": "astro dev --background",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "oxlint --deny-warnings",
