# Vercel: configurar el dominio canónico en Production y Preview.
# Usar una URL completa con https:// y sin rutas adicionales.
# Si se omite, Vercel aporta el dominio de producción del proyecto.
SITE_URL=
# Activar en Production cuando el sitio esté listo para indexarse.
# Las previews de Vercel permanecen noindex incluso si reciben true.
PUBLIC_INDEXABLE=false
# Vercel: configurar en Production y Preview para respetar packageManager.
ENABLE_EXPERIMENTAL_COREPACK=1
