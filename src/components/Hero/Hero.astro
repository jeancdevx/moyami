---
import { site } from '@/config/site'

import Icon from '@/components/Icon'
import World from '@/components/World'
---

<section id='inicio' class='hero page-width' aria-labelledby='hero-title'>
  <div class='hero-copy'>
    <p class='hero-intro'>
      <span class='intro-spark'>
        <Icon name='sparkles' />
      </span>
      Tu próxima parada para algo nuevo
    </p>
    <h1 id='hero-title'>
      Abre algo
      <br />
      diferente.
    </h1>
    <p class='hero-description'>
      Snacks, bebidas y ramen asiáticos para descubrir tu próximo antojo en
      Caraz.
    </p>
    <a class='button button-primary hero-cta' href='#catalogo'>
      Explorar catálogo
      <Icon name='arrowRight' />
    </a>
    <p class='hero-location'>
      <Icon name='mapPin' />
      <span>
        {site.address}
        <br />
        <span class='muted'>Caraz, Áncash</span>
      </span>
    </p>
  </div>
  <World />
</section>
<style>
  .hero {
    display: grid;
    gap: 32px;
    align-items: center;
    padding-top: 48px;
    padding-bottom: 48px;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
  }
  .hero-intro {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 24px;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    font-weight: 600;
  }
  .intro-spark {
    padding: 8px;
    background: var(--color-lila);
    border-radius: 9999px;
    display: inline-flex;
  }
  h1 {
    max-width: 680px;
    font-size: var(--text-6xl);
    line-height: var(--text-6xl--line-height);
    background-image: linear-gradient(90deg, #000000, #666666);
    background-clip: text;
    color: transparent;
  }
  .hero-description {
    max-width: 680px;
    margin-top: 24px;
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
    color: #50594f;
  }
  .hero-cta {
    margin-top: 32px;
    padding-inline: 12px;
  }
  .hero-location {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-top: 32px;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    font-weight: 600;
  }
  .hero-location > .icon {
    color: #5b6c31;
  }
  @media (min-width: 640px) {
    h1 {
      font-size: var(--text-7xl);
      line-height: var(--text-7xl--line-height);
    }
  }
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: 0.95fr 1.05fr;
      gap: 24px;
      padding-top: 64px;
      padding-bottom: 80px;
    }
    h1 {
      font-size: var(--text-8xl);
      line-height: var(--text-8xl--line-height);
    }
    .hero-description {
      max-width: 480px;
    }
  }
</style>
