---
import arrowLeft from '@phosphor-icons/core/assets/regular/arrow-left.svg?raw'
import arrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw'
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw'
import bowl from '@phosphor-icons/core/assets/regular/bowl-food.svg?raw'
import cookie from '@phosphor-icons/core/assets/regular/cookie.svg?raw'
import magnifyingGlass from '@phosphor-icons/core/assets/regular/magnifying-glass.svg?raw'
import mapPin from '@phosphor-icons/core/assets/regular/map-pin.svg?raw'
import minus from '@phosphor-icons/core/assets/regular/minus.svg?raw'
import drink from '@phosphor-icons/core/assets/regular/orange-slice.svg?raw'
import plus from '@phosphor-icons/core/assets/regular/plus.svg?raw'
import sparkles from '@phosphor-icons/core/assets/regular/sparkle.svg?raw'
import x from '@phosphor-icons/core/assets/regular/x.svg?raw'

const icons = {
  arrowRight,
  arrowUpRight,
  arrowLeft,
  mapPin,
  magnifyingGlass,
  plus,
  minus,
  x,
  sparkles,
  cookie,
  bowl,
  drink
}
interface Props {
  name: keyof typeof icons
  class?: string
}
const { name, class: className } = Astro.props
---

<span
  class:list={['icon', className]}
  aria-hidden='true'
  set:html={icons[name]}
/>
